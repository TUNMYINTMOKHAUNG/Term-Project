<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FE">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="80dp">

            <!-- Page title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Picks"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginBottom="20dp" />

            <!-- Weather Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#EEEDFE"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_auto_awesome"
                            app:tint="#5D5CDE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvWeatherStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sunny, 24°C"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A" />

                            <TextView
                                android:id="@+id/tvWeatherTip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perfect for lightweight layers."
                                android:textSize="13sp"
                                android:textColor="#5D5CDE"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Outfit of the Day -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUTFIT OF THE DAY"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textColor="#888888"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/outfitOfDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Top slot -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOotdTop"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <ImageView
                        android:id="@+id/imgOotdTop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#F6F2F8" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom slot -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOotdBottom"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <ImageView
                        android:id="@+id/imgOotdBottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#F6F2F8" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- "Try Dressroom" button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTryDressroom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Try in Dressroom"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:backgroundTint="#5D5CDE"
                app:cornerRadius="14dp"
                android:layout_marginBottom="28dp" />

            <!-- More from your closet -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MORE FROM YOUR CLOSET"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textColor="#888888"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMoreItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>