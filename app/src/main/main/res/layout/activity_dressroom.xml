<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FE">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FBF8FE"
        app:title="Dressroom"
        app:titleTextColor="#1A1A1A"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#1A1A1A"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left panel: clothing slots -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSlots"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/btnGetFeedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- OUTERWEAR slot (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUTERWEAR  —  optional"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/slotOuterwear"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/dashed_border_rect"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgOuterwear"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyOuterwear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="#DCD9DE" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add outerwear"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- TOP slot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/slotTop"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/dashed_border_rect"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgTop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="#DCD9DE" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a top"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Clear button -->
                <ImageButton
                    android:id="@+id/btnClearTop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_cancel"
                    android:background="@drawable/circle_white_bg"
                    android:padding="4dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- BOTTOM slot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOTTOM"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/slotBottom"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/dashed_border_rect"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgBottom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="#DCD9DE" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a bottom"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnClearBottom"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_cancel"
                    android:background="@drawable/circle_white_bg"
                    android:padding="4dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- FOOTWEAR slot (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOOTWEAR  —  optional"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/slotFootwear"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/dashed_border_rect"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/imgFootwear"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyFootwear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="#DCD9DE" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add footwear"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Recommendations section -->
            <TextView
                android:id="@+id/tvRecommendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUGGESTED MATCHES"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- AI Feedback button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetFeedback"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Get AI Styling Feedback"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:backgroundTint="#5D5CDE"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_auto_awesome"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>