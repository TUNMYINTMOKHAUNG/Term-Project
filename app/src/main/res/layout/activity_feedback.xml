<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FE">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Styling Feedback"
        app:titleTextColor="#1C1B1F"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe the event or occasion:"
                android:textSize="14sp"
                android:textColor="#49454F"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/eventInput"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="e.g., Wedding, casual office meeting, dinner date..."
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:textColor="#1C1B1F" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/generateBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Generate Feedback"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                backgroundTint="#6750A4"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/feedbackResultsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/menuTabsChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tabSuitability"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suitability"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tabCombination"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combination" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tabAlternatives"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alternatives" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tabTips"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Styling Tips" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:id="@+id/scoreContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/scoreProgressBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:trackThickness="12dp"
                        app:trackCornerRadius="6dp"
                        app:indicatorColor="#6750A4"
                        app:trackColor="#E6E0E9" />

                    <TextView
                        android:id="@+id/scorePercentageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#6750A4"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="#FFFFFF">

                    <TextView
                        android:id="@+id/dynamicFeedbackContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:text="Loading analysis data..."
                        android:textSize="15sp"
                        android:textColor="#49454F"
                        android:lineSpacingMultiplier="1.4" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>